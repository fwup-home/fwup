#!/bin/sh

#
# Test that fwup doesn't crash on macOS when Disk Arbitration is unavailable.
# This happens when fwup is run in a sandbox that blocks diskarbitrationd.
#

. "$(cd "$(dirname "$0")" && pwd)/common.sh"

case $HOST_OS in
    Darwin)
        if ! command -v sandbox-exec >/dev/null; then
            exit 77
        fi
        ;;
    *)
        exit 77
        ;;
esac

NO_DISK_ARBITRATION='(version 1)(allow default)(deny mach-lookup (global-name "com.apple.DiskArbitration.diskarbitrationd"))'

cd $WORK
if ! sandbox-exec -p "$NO_DISK_ARBITRATION" $FWUP_CREATE -g; then
    echo "fwup -g failed without Disk Arbitration"
    exit 1
fi
cd -

if [ ! -f $WORK/fwup-key.pub ] || [ ! -f $WORK/fwup-key.priv ]; then
    echo "fwup -g didn't create keys without Disk Arbitration"
    exit 1
fi

if ! sandbox-exec -p "$NO_DISK_ARBITRATION" $FWUP_APPLY -D; then
    echo "fwup -D failed without Disk Arbitration"
    exit 1
fi
