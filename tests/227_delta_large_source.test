#!/bin/sh

#
# Verify xdelta updates with a 1T source window. The test data is small,
# but the configured window catches overflow when converting blocks to bytes.
#

. "$(cd "$(dirname "$0")" && pwd)/common.sh"
create_15M_file

FWFILE2="$WORK/fwup2.fw"

cat >"$CONFIG" <<EOF
file-resource rootfs.original {
        host-path = "${TESTFILE_15M}"
}
file-resource rootfs.next {
        host-path = "${TESTFILE_15M}"
}

task complete {
    on-resource rootfs.original { raw_write(1024) }
}
task upgrade {
    on-resource rootfs.next {
        delta-source-raw-offset=1024
        delta-source-raw-count=2097152000
        raw_write(32768)
    }
}
EOF

$FWUP_CREATE -c -f "$CONFIG" -o "$FWFILE"
$FWUP_APPLY -a -d "$IMGFILE" -i "$FWFILE" -t complete

mkdir -p "$WORK/data"
xdelta3 -A -S -f -s "$TESTFILE_15M" "$TESTFILE_15M" "$WORK/data/rootfs.next"
cp "$FWFILE" "$FWFILE2"
(cd "$WORK" && zip -q "$FWFILE2" data/rootfs.next)

$FWUP_APPLY -a -d "$IMGFILE" -i "$FWFILE2" -t upgrade

cmp_bytes 15000000 "$TESTFILE_15M" "$IMGFILE" 0 524288
cmp_bytes 15000000 "$TESTFILE_15M" "$IMGFILE" 0 16777216
